#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/rambla"

: "${HOME:=$IMAGE_HOME}"
: "${RAMBLA_HOME:=${HOME}/.rambla}"
: "${RAMBLA_LISTEN:=0.0.0.0:6767}"
: "${RAMBLA_WEB_UI_ENABLED:=true}"
: "${RAMBLA_LOG_LEVEL:=info}"
: "${RAMBLA_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export RAMBLA_HOME
export RAMBLA_LISTEN
export RAMBLA_WEB_UI_ENABLED
export RAMBLA_LOG_LEVEL
export RAMBLA_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown rambla:rambla "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$RAMBLA_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu rambla "$@"
  fi
  exec "$@"
fi

if [[ -z "${RAMBLA_PASSWORD:-}" ]]; then
  {
    echo "[rambla] WARNING: RAMBLA_PASSWORD is not set."
    echo "[rambla] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[rambla] Set RAMBLA_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/rambla-server-entry ]]; then
  echo "[rambla] FATAL: /etc/rambla-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/rambla-server-entry)"
echo "[rambla] starting daemon on ${RAMBLA_LISTEN} with web UI ${RAMBLA_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu rambla node "$entry"
fi
exec node "$entry"
